      <origin xyz="-0.0183 -0.0205732 0.01205" rpy="1.5707963267949 0 -0.726694369726454"/>
      <mass value="0.0221642"/>
      <inertia ixx="0.00000896853" ixy="0" ixz="0" iyy="0.00000671733" iyz="0" izz="0.00000263931"/>
    </inertial>
    <visual>
      <origin xyz="0.0127 0.06142 0.01205" rpy="1.5707963267948966 0 0"/>
