  <link name="left_inner_finger">
    <inertial>
      <origin xyz="-0.00852976 -0.0014822 -0.00910001" rpy="1.5707963267949 0 2.07511963717801"/>
      <mass value="0.0125222"/>
      <inertia ixx="0.00000267415" ixy="0" ixz="0" iyy="0.0000024559" iyz="0" izz="0.000000602031"/>
    </inertial>
    <visual name="follower">
      <origin xyz="0.0509079 -0.10392 -0.0091" rpy="-1.5707963267948966 0 0"/>
      <geometry><mesh filename="robotiq_2f_85/meshes/menagerie_v4/follower.stl" scale="1 1 1"/></geometry>
