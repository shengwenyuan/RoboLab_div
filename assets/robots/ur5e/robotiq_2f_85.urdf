<?xml version="1.0"?>
<!--
  Robotiq 2F-85 simulation model.

  Geometry, body frames, and per-part inertia are ported as one coherent set
  from MuJoCo Menagerie robotiq_2f85_v4 at pinned commit 71f066ad. That model
  was rebuilt from Robotiq STEP CAD. Its nominal closed-loop trajectory is
  represented here by one driven joint and five +1 mimic joints; the maximum
  nominal pad-position error against the MJCF equality solution is 1.64 um.

  The root is the physical installation frame (Z=0 at the mounting plane),
  +Z points distally, and the jaws open along +/-X. In the UR5e assembly the
  root is fixed to tool0 with zero translation and a +90 degree yaw so the jaw
  opening direction remains compatible with RoboLab's previous Berkeley setup.
-->
<robot name="robotiq_2f_85_v4">
  <material name="robotiq_black">
    <color rgba="0.149 0.149 0.149 1"/>
  </material>
  <material name="robotiq_gray">
    <color rgba="0.4627 0.4627 0.4627 1"/>
  </material>
  <material name="robotiq_metal">
    <color rgba="0.58 0.58 0.58 1"/>
  </material>
  <material name="robotiq_silicone">
    <color rgba="0.10 0.10 0.10 1"/>
  </material>

  <link name="robotiq_arg2f_base_link">
    <inertial>
      <!-- Source COM was recentered on X/Y symmetry and shifted on Z so the
           complete 0.9 kg open gripper matches Robotiq's published 57 mm COM. -->
      <origin xyz="0 0 0.0513638010204602" rpy="-0.0133589866006165 -0.00273634931746663 1.57740076216174"/>
      <mass value="0.777441"/>
      <inertia ixx="0.000260285" ixy="0" ixz="0" iyy="0.000225381" iyz="0" izz="0.000152708"/>
    </inertial>
    <visual name="base">
      <origin xyz="0 0 0.0108" rpy="0 0 3.141592653589793"/>
      <geometry><mesh filename="robotiq_2f_85/meshes/menagerie_v4/base.stl" scale="1 1 1"/></geometry>
      <material name="robotiq_black"/>
    </visual>
    <visual name="ur_coupling">
      <origin xyz="0 0 0.004" rpy="-1.5707963267948966 0 0"/>
      <geometry><mesh filename="robotiq_2f_85/meshes/menagerie_v4/base_coupling.stl" scale="1 1 1"/></geometry>
      <material name="robotiq_black"/>
    </visual>
    <visual name="base_cover">
      <origin xyz="0 0 0.0108" rpy="0 0 0"/>
      <geometry><mesh filename="robotiq_2f_85/meshes/menagerie_v4/c-a01-85-open.stl" scale="1 1 1"/></geometry>
      <material name="robotiq_metal"/>
    </visual>
    <collision name="base">
      <origin xyz="0 0 0.0108" rpy="0 0 3.141592653589793"/>
      <geometry><mesh filename="robotiq_2f_85/meshes/menagerie_v4/base.stl" scale="1 1 1"/></geometry>
    </collision>
    <collision name="ur_coupling">
      <origin xyz="0 0 0.004" rpy="-1.5707963267948966 0 0"/>
      <geometry><mesh filename="robotiq_2f_85/meshes/menagerie_v4/base_coupling.stl" scale="1 1 1"/></geometry>
    </collision>
  </link>

  <link name="left_outer_knuckle">
    <inertial>
      <origin xyz="-0.0175297 0.00165308 -0.00469625" rpy="-1.5707963267949 0 -1.68881486095799"/>
      <mass value="0.00899563"/>
      <inertia ixx="0.00000172352" ixy="0" ixz="0" iyy="0.00000160906" iyz="0" izz="0.000000322006"/>
    </inertial>
    <visual>
      <origin xyz="0.0306011 0.0549045 -0.0047" rpy="1.5707963267948966 0 0"/>
      <geometry><mesh filename="robotiq_2f_85/meshes/menagerie_v4/driver.stl" scale="1 1 1"/></geometry>
      <material name="robotiq_gray"/>
    </visual>
    <collision>
      <origin xyz="0.0306011 0.0549045 -0.0047" rpy="1.5707963267948966 0 0"/>
